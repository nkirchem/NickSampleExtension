{
  "$schema": "./src/node_modules/@microsoft/azureportal-build/lib/definitions/extension.config.schema.json",
  "name": "NickSampleExtension",
  "version": "1.0.1",
  "sourceDirectory": "./src",
  "devServer": {
    "port": 1340,
    "sideLoadTarget": {
      "baseUrl": "https://localhost:55555/Portal",
      "view": "Fluent9Demo.ReactView"
    }
  },
  "build": {
    "devToolDevelopment": "eval",
    "versionedLibraries": {
      "react": 18
    },
    "fluent": {
      "externalizeFluent9": true,
      "allowedVersions": "fluent1And2"
    },
    "performance": {
      "typeCheckingParallelization": true
    },
    "resJson": {
      "optimizeRuntimePerformance": true,
      "localizeDebugContent": false
    }
  },
  "environment": {
    "deepmergeProperties": ["features"],
    "*": {
      "enablePortalLogging": true,
      "armApiVersion": "2014-04-01",
      "reflowReadyDefault": true,
      "trustedDomains": [],
      "argbrowseoptions": {
        "MyResource": "Force"
      }
    },
    "df.onecloud.azure-test.net": {},
    "onestb.cloudapp.net": {},
    "portal.azure.cn": {},
    "portal.azure.com": {
      "features": {
        "regionSegments": true
      }
    },
    "portal.azure.us": {},
    "ms.portal.azure.com": {
      "features": {
        "feature1": "true",
        "feature2": "true"
      }
    },
    "localhost#55555": {
      "armEndpoint": "https://management.azure.com",
      "trustedDomains": ["localhost"]
    }
  }
}
